{
  "info": {
    "name": "PawConnect",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "demoPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public catalog",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pets",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Signed-out create denied",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/pets",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Demo Cat\",\n  \"species\": \"Cat\",\n  \"age\": \"1 year\",\n  \"location\": \"Toronto, ON\",\n  \"description\": \"A test listing for the COMP229 demo.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register visitor",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/users/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Visitor\",\n  \"email\": \"{{visitorEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"role\": \"staff\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('visitorEmail', 'visitor-' + Date.now() + '@example.test');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Registration assigns visitor role', () => pm.expect(pm.response.json().role).to.eql('visitor'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Visitor login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/users/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{visitorEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('visitorToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Visitor create denied",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/pets",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{visitorToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Demo Cat\",\n  \"species\": \"Cat\",\n  \"age\": \"1 year\",\n  \"location\": \"Toronto, ON\",\n  \"description\": \"A test listing for the COMP229 demo.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Maple staff login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/users/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"maple@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('ownerToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Signed-in profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Staff profile returned', () => pm.expect(pm.response.json().role).to.eql('staff'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create a listing",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/pets",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Demo Cat\",\n  \"species\": \"Cat\",\n  \"age\": \"1 year\",\n  \"location\": \"Toronto, ON\",\n  \"description\": \"A test listing for the COMP229 demo.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('petId', pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read the listing",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pets/{{petId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Listing name persisted', () => pm.expect(pm.response.json().name).to.eql('Postman Demo Cat'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update adoption status",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/pets/{{petId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Adoption Pending\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Adoption status updated', () => pm.expect(pm.response.json().status).to.eql('Adoption Pending'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cedar staff login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/users/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cedar@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('otherToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Other staff update denied",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/pets/{{petId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{otherToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Adopted\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Other staff delete denied",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/pets/{{petId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read status after denied edits",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pets/{{petId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Saved status preserved', () => pm.expect(pm.response.json().status).to.eql('Adoption Pending'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Owner deletes listing",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/pets/{{petId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted listing is gone",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/pets/{{petId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
