{
  "name": "pawconnect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"npm:web\"",
    "api": "node --env-file=.env --watch server/index.js",
    "web": "vite --host 127.0.0.1",
    "seed": "node --env-file=.env server/seed.js",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "build:preview": "vite build --mode preview"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "concurrently": "^9.2.1"
  }
}
